{
  "rewrites": [
    {
      "source": "/game",
      "destination": "/game.html"
    },
    {
      "source": "/game/",
      "destination": "/game.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/news-cron",
      "schedule": "0 8 * * *"
    }
  ]
}
